{
  "name": "auto-mode-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic permission gate for OpenCode and Pi",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/opencode-runtime.ts",
    "./pi": "./src/pi-runtime.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "opencode-plugin",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/pi-runtime.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts"
  }
}

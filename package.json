{
  "name": "auto-mode-gate",
  "version": "0.3.0",
  "description": "Deterministic permission gate for OpenCode and Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yivas/auto-mode-gate.git"
  },
  "homepage": "https://github.com/Yivas/auto-mode-gate#readme",
  "bugs": {
    "url": "https://github.com/Yivas/auto-mode-gate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/opencode-runtime.ts",
    "./server": "./src/opencode-runtime.ts",
    "./pi": "./src/pi-runtime.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode-plugin",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/pi-runtime.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts"
  }
}
